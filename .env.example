# Copy to .env (never commit it). Used by docker compose.
# 32+ random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRISISROUTE_JWT_SECRET_KEY=
CRISISROUTE_ENVIRONMENT=production
CRISISROUTE_CORS_ORIGINS=http://localhost:8000
# Operators file: copy deploy/users.example.json to deploy/users.json and fill in password hashes
CRISISROUTE_USERS_FILE_PATH=./deploy/users.json
